# .env_modelo
# Este archivo sirve como plantilla. Cópialo y renómbralo a ".env"
# Luego completa los valores con tus credenciales locales
# Importante: el archivo .env NUNCA debe subirse al repositorio (está en .gitignore)

SECRET_KEY=genera-una-clave-secreta-aleatoria-y-segura
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:4200
DB_NAME=nombre_de_tu_base_de_datos
DB_USER=tu_usuario_mysql
DB_PASSWORD=tu_contraseña_mysql
DB_HOST=localhost
DB_PORT=3306